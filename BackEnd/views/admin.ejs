<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Admin | EJS Rendered</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        h1 {
            color: #2d3436;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-top: 0;
        }

        .badge {
            background: #6c5ce7;
            color: white;
            padding: 4px 12px;
            border-radius: 10px;
            font-size: 14px;
            margin-left: 10px;
        }

        .stats-grid {
            display: grid;
            grid-cols: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .stat-card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
            border: 1px solid #edf2f7;
        }

        .stat-label {
            color: #7f8c8d;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 24px;
            font-weight: bold;
            color: #2d3436;
            margin-top: 5px;
        }

        .footer {
            margin-top: 40px;
            font-size: 12px;
            color: #bdc3c7;
            text-align: center;
        }

        .info-box {
            background: #e1f5fe;
            border-left: 5px solid #03a9f4;
            padding: 15px;
            margin-top: 30px;
            font-size: 14px;
            line-height: 1.6;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Server Status <span class="badge">EJS Page</span></h1>

        <p>EJS PAGE</p>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Registered Users</div>
                <div class="stat-value">
                    <%= userCount %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Bills Recorded</div>
                <div class="stat-value">
                    <%= billCount %>
                </div>
            </div>
        </div>

        <div class="footer">
            Generated at <%= new Date().toLocaleString() %> | ExpenseTracker System
        </div>
    </div>
</body>

</html>